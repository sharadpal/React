import {useState} from "react";
import "./Lottery.css";
import { genTick } from "./helper";

export default function Lottery1() {
    let[ticket,setTicket]=useState(genTick(3));

    return (
        <div>
            <h1> Lottery Game!</h1>
            <div className="ticket">
                <span>{ticket[0]}</span>
                <span>{ticket[1]}</span>
                <span>{ticket[2]}</span>
            </div>

        </div>
    )
}

//-------------------------------------------------- helper.js

function genTick(n) {
    let arr=new Array(n)
    for(let i=0;i<n;i++){
        arr[i]=Math.floor(Math.random()*10);
    }
    return arr;
}
export {genTick};

